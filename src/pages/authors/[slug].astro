---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { publishedArticles, base } from '../../lib';

export async function getStaticPaths() {
  return (await getCollection('authors')).map((author) => ({ params: { slug: author.id }, props: { author } }));
}
const { author } = Astro.props;
const all = await publishedArticles();
const written = all.filter((a) => a.data.authors.some((r) => r.id === author.id));
const edited = all.filter((a) => a.data.editors.some((r) => r.id === author.id));
const roleLine = [author.data.role, author.data.gradYear && `Class of ${author.data.gradYear}`].filter(Boolean).join(', ');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.data.name,
  jobTitle: author.data.role,
  description: author.data.bio,
  url: new URL(`${base}/authors/${author.id}`, Astro.site).href,
  affiliation: { '@type': 'Organization', name: 'The Berkeley Carroll Science Journal', url: Astro.site?.href },
  sameAs: author.data.links.map((l) => l.url),
});
---
<Base title={author.data.name} description={`${author.data.name}, ${roleLine}. ${author.data.bio}`} image={`${base}/og/authors/${author.id}.png`}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <header class="grid gap-6 sm:grid-cols-[auto_1fr] sm:gap-10 items-start max-w-4xl">
    {author.data.photo && <Image src={author.data.photo} alt={author.data.name} width={320} height={320} class="w-32 h-32 sm:w-40 sm:h-40 object-cover rounded-full" />}
    <div>
      <p class="meta">{roleLine}</p>
      <h1 class="display mt-2 text-t2">{author.data.name}</h1>
      <p class="mt-4 max-w-[55ch] text-lede">{author.data.bio}</p>
      {author.data.links.length > 0 && (
        <p class="mt-4 font-sans text-sm">{author.data.links.map((l, i) => <>{i > 0 && ', '}<a class="link-ink" href={l.url} rel="noopener">{l.label}</a></>)}</p>
      )}
    </div>
  </header>

  <section class="mt-14" aria-labelledby="written">
    <h2 id="written" class="meta text-ink font-medium mb-1">Articles{written.length > 0 && ` (${written.length})`}</h2>
    {written.length === 0 ? <p class="py-6 border-t border-rule text-muted">No published articles yet.</p> : written.map((a) => <ArticleRow article={a} showDate />)}
  </section>

  {edited.length > 0 && (
    <section class="mt-14" aria-labelledby="edited">
      <h2 id="edited" class="meta text-ink font-medium mb-1">Edited ({edited.length})</h2>
      {edited.map((a) => <ArticleRow article={a} showDate />)}
    </section>
  )}
</Base>
