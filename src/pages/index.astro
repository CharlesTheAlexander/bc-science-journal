---
import { Image } from 'astro:assets';
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { getEntry } from 'astro:content';
import { joinNames, liveIssues, publishedArticles, sectionsInOrder, ROLE_ORDER, base } from '../lib';

const [issue] = await liveIssues();
const description = 'A student-run magazine of science, math, computing, and medicine at the Berkeley Carroll School in Brooklyn.';

let featured: Awaited<ReturnType<typeof getEntries<'articles'>>> = [];
let rest: Awaited<ReturnType<typeof publishedArticles>> = [];
let bySection: { name: string; id: string; articles: typeof rest }[] = [];
let Note: any = null;
if (issue) {
  const all = (await publishedArticles()).filter((a) => a.data.issue.id === issue.id);
  featured = await getEntries(issue.data.featuredArticles);
  const featuredIds = new Set(featured.map((f) => f.id));
  rest = all.filter((a) => !featuredIds.has(a.id));
  bySection = (await sectionsInOrder())
    .map((s) => ({ name: s.data.name, id: s.id, articles: rest.filter((a) => a.data.section.id === s.id) }))
    .filter((s) => s.articles.length > 0);
  Note = (await render(issue)).Content;
}
const leadSection = featured[0] ? await getEntry(featured[0].data.section) : undefined;
const leadAuthors = featured[0] ? await getEntries(featured[0].data.authors) : [];
const staff = (await getCollection('authors', (a) => a.data.role !== 'Alumni' && a.data.role !== 'Staff Writer'))
  .sort((a, b) => ROLE_ORDER.indexOf(a.data.role as any) - ROLE_ORDER.indexOf(b.data.role as any));
---
<Base title="The Berkeley Carroll Science Journal" description={description} image={issue ? `${base}/og/issues/${issue.id}.png` : undefined}>
  {issue ? (
    <>
      <section class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:gap-14 items-start">
        <a href={`${base}/issues/${issue.id}`} class="block">
          <Image src={issue.data.coverImage} alt={`${issue.data.title} cover`} width={1200} height={675} class="w-full aspect-[16/9] object-cover" loading="eager" />
        </a>
        <div>
          <p class="meta">{issue.data.title}, {issue.data.season}</p>
          <h1 class="display mt-2 text-t2"><a href={`${base}/issues/${issue.id}`} class="no-underline hover:text-accent">{issue.data.title}</a></h1>
          <div class="prose mt-5 line-clamp-[8]"><Note /></div>
          <p class="mt-4 font-sans text-sm"><a class="link-ink" href={`${base}/issues/${issue.id}`}>Read the full editor’s note and table of contents</a></p>
        </div>
      </section>

      {featured.length > 0 && (
        <section class="mt-14" aria-labelledby="featured">
          <h2 id="featured" class="meta text-ink font-medium mb-1">Featured in this issue</h2>
          <article class="grid gap-5 lg:grid-cols-[1fr_1fr] lg:gap-14 items-start py-6 border-t border-rule">
            <a href={`${base}/articles/${featured[0].id}`} tabindex="-1" aria-hidden="true">
              <Image src={featured[0].data.coverImage} alt="" widths={[640, 960, 1200]} sizes="(min-width: 64rem) 36rem, 100vw" class="w-full aspect-[16/9] object-cover" loading="eager" />
            </a>
            <div>
              <p class="meta"><a class="link-ink" href={`${base}/sections/${featured[0].data.section.id}`}>{leadSection?.data.name}</a></p>
              <h3 class="display text-t2 mt-2"><a href={`${base}/articles/${featured[0].id}`} class="no-underline hover:text-accent">{featured[0].data.title}</a></h3>
              {featured[0].data.subtitle && <p class="mt-3 text-lede text-muted">{featured[0].data.subtitle}</p>}
              <p class="mt-4 max-w-[52ch] leading-relaxed">{featured[0].data.abstract}</p>
              <p class="meta mt-4">{joinNames(leadAuthors.map((a) => a.data.name))}</p>
            </div>
          </article>
          {featured.slice(1).map((a) => <ArticleRow article={a} large />)}
        </section>
      )}

      {bySection.map((s) => (
        <section class="mt-14" aria-labelledby={`s-${s.id}`}>
          <h2 id={`s-${s.id}`} class="meta text-ink font-medium mb-1"><a class="link-ink" href={`${base}/sections/${s.id}`}>{s.name}</a></h2>
          {s.articles.map((a) => <ArticleRow article={a} showSection={false} />)}
        </section>
      ))}
    </>
  ) : (
    <>
      <section class="max-w-4xl">
        <h1 class="display text-t1">Science, written by the students who are doing it.</h1>
        <p class="mt-6 max-w-[60ch] text-lede">
          The Berkeley Carroll Science Journal is a new student-run magazine for research, summer programs, explainers, and takes on current science. The first issue publishes in January 2027.
        </p>
        <p class="mt-5 font-sans text-sm text-muted">Pitches due October 9, 2026. Issue 1 publishes January 22, 2027.</p>
        <p class="mt-6 font-sans text-base">
          <a class="link-ink" href={`${base}/submit`}>Write for the first issue</a>
          <span class="mx-3 text-rule" aria-hidden="true">|</span>
          <a class="link-ink" href={`${base}/about`}>What the journal is</a>
        </p>
      </section>

      <section class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <h2 class="text-2xl">Who can write</h2>
          <p class="mt-2 text-muted leading-relaxed">Anyone at Berkeley Carroll. Biology, chemistry, physics, math, computer science and AI, environment, medicine, ethics. First-time writers are the point.</p>
        </div>
        <div>
          <h2 class="text-2xl">What gets published</h2>
          <p class="mt-2 text-muted leading-relaxed">Your own research, what a summer program was really like, an explainer on something you’re into, a take on a recent science story. Every piece is edited and read by the faculty advisor.</p>
        </div>
        <div>
          <h2 class="text-2xl">Why it’s worth it</h2>
          <p class="mt-2 text-muted leading-relaxed">A published, edited piece with your name on it, at a stable address you can point to. Two pieces earn an Associate Editor title on the masthead.</p>
        </div>
      </section>

      <section class="mt-16" aria-labelledby="staff">
        <h2 id="staff" class="meta text-ink font-medium mb-1">Founding staff</h2>
        <ul class="border-t border-rule">
          {staff.map((p) => (
            <li class="grid grid-cols-[9rem_1fr] gap-x-8 py-3 border-b border-rule">
              <span class="meta pt-0.5">{p.data.role}</span>
              <a class="link-ink text-lg" href={`${base}/authors/${p.id}`}>{p.data.name}</a>
            </li>
          ))}
        </ul>
      </section>
    </>
  )}
</Base>
