---
import { Image } from 'astro:assets';
import { getEntries, getEntry } from 'astro:content';
import { fmtDate, joinNames, readingTime, type Article, base } from '../lib';

interface Props {
  article: Article;
  showSection?: boolean;
  showDate?: boolean;
  large?: boolean;
}
const { article, showSection = true, showDate = false, large = false } = Astro.props;
const authors = await getEntries(article.data.authors);
const section = await getEntry(article.data.section);
const href = `${base}/articles/${article.id}`;
---
<article class="grid grid-cols-[1fr_5rem] gap-x-4 gap-y-1 py-5 sm:py-6 border-t border-rule items-start sm:grid-cols-[9rem_1fr_8rem] sm:gap-x-8">
  {showSection ? (
    <p class="meta col-span-2 sm:col-span-1 sm:pt-1 mb-1 sm:mb-0">
      <a class="link-ink" href={`${base}/sections/${section?.id}`}>{section?.data.name}</a>
    </p>
  ) : (
    <span class="hidden sm:block" />
  )}
  <div class="min-w-0">
    <h3 class:list={['display', large ? 'text-t3' : 'text-t4']}>
      <a href={href} class="no-underline hover:text-accent">{article.data.title}</a>
    </h3>
    {article.data.subtitle && <p class="mt-1 text-[1.05rem] sm:text-lg text-muted leading-snug">{article.data.subtitle}</p>}
    <p class="meta mt-2">
      {joinNames(authors.map((a) => a.data.gradYear ? `${a.data.name} \u2019${String(a.data.gradYear).slice(2)}` : a.data.name))}
      {showDate && <span>, {fmtDate(article.data.publishDate)}</span>}
      <span>, {readingTime(article.body)} min read</span>
    </p>
  </div>
  <a href={href} tabindex="-1" aria-hidden="true" class="block w-full mt-1">
    <Image src={article.data.coverImage} alt="" width={256} height={144} class="w-full aspect-[16/9] object-cover" loading="lazy" />
  </a>
</article>
